# Copy to .env.local for local development. On Vercel, set these under Project Settings > Environment Variables.

# MailerLite API key (server-side only; never exposed to the browser). Used by /api/subscribe to save leads:
#   "3 Tips Opt-In" group  <- homepage hero + "Get My 3 FREE Tips" forms
#   "Leads" group          <- /contact and /google application forms
# Without it the forms show a friendly error instead of saving, and the build still works.
MAILERLITE_API_KEY=

# Optional: real production domain (canonical URLs, sitemap, schema). Defaults to https://www.lucrosresults.com
# NEXT_PUBLIC_SITE_URL=https://www.lucrosresults.com
